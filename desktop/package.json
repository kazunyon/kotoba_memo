{
  "name": "kotoba-memo-desktop",
  "version": "0.2.0",
  "private": true,
  "main": "main.cjs",
  "description": "利用者自身のGoogle CloudとDriveで使うことばメモ",
  "author": "Kotoba Memo contributors",
  "scripts": {
    "start": "electron .",
    "dist:windows": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "40.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "org.kotobamemo.desktop",
    "productName": "ことばメモ",
    "directories": {
      "output": "../release"
    },
    "files": [
      "*.cjs",
      "setup.*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "kotoba-memo-setup.exe",
      "installerLanguages": [
        "ja_JP"
      ]
    }
  }
}
